---
import '../estilos/sobre-mi.css';
import { obtenerTextos, idiomaPorDefecto, type Idioma } from '../i18n';
import IconoTecnologia from './IconoTecnologia.astro';

interface Props {
	/** Idioma de los textos de la sección. */
	idioma?: Idioma;
}

const { idioma = idiomaPorDefecto } = Astro.props;
const textos = obtenerTextos(idioma);
	const { titulo, altFoto, nombre, rol, presentacion, formacion, stacks, idiomas } = textos.sobreMi;
---

<section id="sobre-mi" class="seccion sobre-mi" aria-labelledby="titulo-sobre-mi">
	<div class="contenedor">
		<h2 id="titulo-sobre-mi" class="titulo-seccion revelar">{titulo}</h2>

		<div class="perfil">
			<figure class="perfil__foto revelar" style="--retardo-revelado: 0.05s;">
				<div class="perfil__foto-marco">
					<img
						class="perfil__foto-img"
						src="/img/foto-perfil.jpg"
						alt={altFoto}
						width="900"
						height="1100"
						loading="lazy"
						decoding="async"
					/>
				</div>
			</figure>

			<div class="perfil__intro revelar" style="--retardo-revelado: 0.1s;">
				<header class="perfil__encabezado">
					<h3 class="perfil__nombre">{nombre}</h3>
					<p class="perfil__rol">{rol}</p>
				</header>

				<div class="perfil__texto">
					{presentacion.map((parrafo) => <p class="perfil__parrafo">{parrafo}</p>)}
				</div>

				<aside class="formacion">
					<span class="perfil__etiqueta">{formacion.etiqueta}</span>
					<p class="formacion__titulo">{formacion.titulo}</p>
					<dl class="formacion__campos">
						{
							formacion.campos.map((campo) => (
								<div class="formacion__campo">
									<dt class="formacion__campo-etiqueta">{campo.etiqueta}</dt>
									<dd class="formacion__campo-valor">{campo.valor}</dd>
								</div>
							))
						}
					</dl>
				</aside>
			</div>
		</div>

		<section class="certificaciones revelar" aria-labelledby="titulo-certificaciones">
			<header class="certificaciones__encabezado">
				<h3 id="titulo-certificaciones" class="perfil__etiqueta">{textos.sobreMi.certificaciones.etiqueta}</h3>
				<p class="certificaciones__descripcion">{textos.sobreMi.certificaciones.descripcion}</p>
			</header>
			<div class="carrusel" data-carrusel>
				<button
					class="carrusel__boton carrusel__boton--anterior"
					type="button"
					aria-label="Anterior"
					data-boton-anterior
				>
					<span aria-hidden="true">&#10094;</span>
				</button>
				<div class="carrusel__contenedor" data-carrusel-contenedor>
					<img class="carrusel__imagen" src="/img/1731339670085.jpeg" alt="Certificación" loading="lazy" decoding="async" />
					<img class="carrusel__imagen" src="/img/1734828210120.jpeg" alt="Certificación" loading="lazy" decoding="async" />
					<img class="carrusel__imagen" src="/img/1775245049359.jpeg" alt="Certificación" loading="lazy" decoding="async" />
					<img class="carrusel__imagen" src="/img/1781032495957.jpeg" alt="Certificación" loading="lazy" decoding="async" />
					<img class="carrusel__imagen" src="/img/1786647657983.jpeg" alt="Certificación" loading="lazy" decoding="async" />
				</div>
				<button
					class="carrusel__boton carrusel__boton--siguiente"
					type="button"
					aria-label="Siguiente"
					data-boton-siguiente
				>
					<span aria-hidden="true">&#10095;</span>
				</button>
				<div class="carrusel__indicadores" data-carrusel-indicadores></div>
			</div>
		</section>

		<div class="stacks">
			<section class="stack stack--principal revelar" aria-labelledby="titulo-stack-principal">
				<header class="stack__encabezado">
					<h3 id="titulo-stack-principal" class="stack__etiqueta">{stacks.principal.etiqueta}</h3>
					<p class="stack__descripcion">{stacks.principal.descripcion}</p>
				</header>
				<ul class="tarjetas-tech" role="list">
					{
						stacks.principal.items.map((item) => (
							<li class:list={['tarjeta-tech', { 'tarjeta-tech--destacada': item.destacado }]}>
								<IconoTecnologia tecnologia={item.nombre} />
								<div class="tarjeta-tech__cuerpo">
									<span class="tarjeta-tech__nombre">{item.nombre}</span>
									<p class="tarjeta-tech__texto">{item.descripcion}</p>
								</div>
							</li>
						))
					}
				</ul>
			</section>

			<section class="stack stack--secundario revelar" aria-labelledby="titulo-stack-secundario">
				<header class="stack__encabezado">
					<h3 id="titulo-stack-secundario" class="stack__etiqueta">{stacks.secundario.etiqueta}</h3>
					<p class="stack__descripcion">{stacks.secundario.descripcion}</p>
				</header>
				<ul class="chips" role="list">
					{
						stacks.secundario.items.map((tecnologia) => (
							<li class="chip">
								<IconoTecnologia tecnologia={tecnologia} />
								<span>{tecnologia}</span>
							</li>
						))
					}
				</ul>
			</section>

			<section class="stack stack--complementario revelar" aria-labelledby="titulo-stack-complementario">
				<header class="stack__encabezado">
					<h3 id="titulo-stack-complementario" class="stack__etiqueta">
						{stacks.complementario.etiqueta}
					</h3>
					<p class="stack__descripcion">{stacks.complementario.descripcion}</p>
				</header>
				<ul class="chips chips--tenue" role="list">
					{
						stacks.complementario.items.map((tecnologia) => (
							<li class="chip">
								<IconoTecnologia tecnologia={tecnologia} />
								<span>{tecnologia}</span>
							</li>
						))
					}
				</ul>
			</section>

			<section class="stack stack--idiomas revelar" aria-labelledby="titulo-idiomas">
				<header class="stack__encabezado">
					<h3 id="titulo-idiomas" class="stack__etiqueta">{idiomas.etiqueta}</h3>
				</header>
				<ul class="idiomas" role="list">
					{idiomas.valores.map((valor) => <li class="idioma">{valor}</li>)}
				</ul>
			</section>
		</div>
	</div>
	<script is:inline>
		(function () {
			const carrusel = document.querySelector('[data-carrusel]');
			if (!carrusel) return;
			const contenedor = carrusel.querySelector('[data-carrusel-contenedor]');
			const anterior = carrusel.querySelector('[data-boton-anterior]');
			const siguiente = carrusel.querySelector('[data-boton-siguiente]');
			const indicadores = carrusel.querySelector('[data-carrusel-indicadores]');
			const imagenes = carrusel.querySelectorAll('.carrusel__imagen');
			if (!contenedor || !imagenes.length) return;
			let indice = 0;
			function mostrar(i) {
				indice = (i + imagenes.length) % imagenes.length;
				contenedor.scrollTo({ left: imagenes[indice].offsetLeft, behavior: 'smooth' });
				indicadores.querySelectorAll('button').forEach((b, j) => {
					b.setAttribute('aria-current', String(j === indice));
				});
			}
			imagenes.forEach((_, i) => {
				const btn = document.createElement('button');
				btn.className = 'carrusel__indicador';
				btn.setAttribute('aria-label', 'Ir a imagen ' + (i + 1));
				btn.addEventListener('click', () => mostrar(i));
				indicadores.appendChild(btn);
			});
			anterior?.addEventListener('click', () => mostrar(indice - 1));
			siguiente?.addEventListener('click', () => mostrar(indice + 1));
			const observer = new IntersectionObserver(
				(entries) => {
					entries.forEach((e) => {
						if (e.isIntersecting) mostrar(indice);
					});
				},
				{ threshold: 0.6 }
			);
			imagenes.forEach((img) => observer.observe(img));
			mostrar(0);
		})();
	</script>
</section>
